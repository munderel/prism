generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// === NEXTAUTH MODELS ===

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}


// === CORE MODELS ===

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  image                 String?
  emailVerified         DateTime?
  googleRefreshToken    String?   @db.Text
  googleTokenExpiresAt  DateTime?
  mtp                   String?   @db.Text
  isAdmin               Boolean   @default(false)
  hasCompletedOnboarding Boolean  @default(false)
  timezone              String    @default("America/New_York")
  hiddenFeatures        Json      @default("[]")
  workingHoursStart     String?   // "HH:mm" format, e.g. "09:00"
  workingHoursEnd       String?   // "HH:mm" format, e.g. "17:00"
  casualHoursStart      String?   // "HH:mm" format, e.g. "17:00"
  casualHoursEnd        String?   // "HH:mm" format, e.g. "22:00"
  // Auth fields
  passwordHash          String?   @db.Text
  totpSecret            String?   @db.Text
  is2FAEnabled          Boolean   @default(false)
  isLockedOut           Boolean   @default(false)
  isPublicOnLeaderboard Boolean   @default(true)
  streakCountAims      Boolean @default(true)
  streakCountProcesses Boolean @default(true)
  streakCountReviews   Boolean @default(true)
  streakCountPowerdown Boolean @default(true)
  taskSchedulePeriod    String?   // "working" | "casual" | "both"
  selectedCalendarIds   Json      @default("[]") // String[] of Google Calendar IDs to sync
  syncTargetCalendarId  String?   // Google Calendar ID to push events to (null = 'primary')
  calendarColorOverrides Json     @default("{}") // Record<calendarId, hexColor> overrides
  googleSyncState       Json      @default("{}") // Recurring Google Calendar sync metadata and exceptions
  powerdownTime         String?   // "HH:mm" format, e.g. "17:30"
  weeklyReviewDayOfWeek Int?      // 0=Sun,1=Mon,...6=Sat
  weeklyReviewTime      String?   // "HH:mm" format, e.g. "10:00"
  weeklyReviewDuration  Int?      // minutes, defaults to 60
  monthlyReviewRecurrenceRule String? // "last-friday", "1st-monday", "15th", etc.
  monthlyReviewTime            String? // "HH:mm" format
  monthlyReviewDuration        Int?    // minutes
  yearlyReviewRecurrenceRule   String? // "dec-30", "last-sat-dec", "custom:MM-DD"
  yearlyReviewTime             String? // "HH:mm" format
  yearlyReviewDuration         Int?    // minutes
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts              Account[]
  goalStacks            GoalStack[]
  tasks                 Task[]
  reviews               Review[]
  streaks               Streak[]
  publicWins            PublicWin[]
  powerdownSessions     PowerdownSession[]
  taskComments          TaskComment[]
  commentMentions       CommentMention[]
  pushSubscriptions     PushSubscription[]
  notificationPreference NotificationPreference?
  configVersions        ConfigVersion[]
  invitations           Invitation[]
  assignedProcesses    Process[]          @relation("ProcessAssignee")
  delegatedProcesses   Process[]          @relation("ProcessDelegate")
  processExecutions    ProcessExecution[]
  meetings             Meeting[]
  ideas                Idea[]
  assignedTasks        Task[]             @relation("TaskAssignee")
  userAims             UserAim[]
  aimInstances         AimInstance[]
  distractionLogs      DistractionLog[]
  trainingItems        TrainingItem[]
  feedback             Feedback[]
  goalAssignments      GoalAssignee[]
  processKpiEntries    ProcessKpiEntry[]
  recurringTeamReviews RecurringTeamReview[] @relation("TeamReviewCreator")
  teamReviewMemberships RecurringTeamReviewMember[]
}

model CompanySettings {
  id         String   @id @default(cuid())
  companyMtp String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GoalStack {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  isCompany  Boolean  @default(false)
  visibility   String   @default("private") // "private" | "group" | "company"
  weekStartDay Int      @default(0)         // 0 = Sunday, 1 = Monday
  createdAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  goals          Goal[]
  configVersions ConfigVersion[]

  @@index([ownerId])
}

enum GoalLevel {
  HIGH_HARD
  STRATEGIC
  MONTHLY
  WEEKLY
  DAILY
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum KpiType {
  NUMERIC
  BINARY
}

model Goal {
  id          String     @id @default(cuid())
  stackId     String
  parentId    String?
  level       GoalLevel
  title       String
  description String?    @db.Text
  status      GoalStatus @default(NOT_STARTED)
  progressPct Float      @default(0)
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int        @default(0)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  stack              GoalStack  @relation(fields: [stackId], references: [id], onDelete: Cascade)
  parent             Goal?      @relation("GoalHierarchy", fields: [parentId], references: [id])
  children           Goal[]     @relation("GoalHierarchy")
  tasks              Task[]
  companyGoalLinks   GoalLink[] @relation("CompanyGoal")
  individualGoalLinks GoalLink[] @relation("IndividualGoal")
  publicWins         PublicWin[]
  kpis               Kpi[]
  processKpis        ProcessKpi[]
  trainingItems      TrainingItem[]
  assignees          GoalAssignee[]

  @@index([stackId])
  @@index([parentId])
  @@index([deletedAt])
}

model GoalLink {
  id               String   @id @default(cuid())
  companyGoalId    String
  individualGoalId String
  weight           Float    @default(1.0)
  createdAt        DateTime @default(now())

  companyGoal    Goal @relation("CompanyGoal", fields: [companyGoalId], references: [id], onDelete: Cascade)
  individualGoal Goal @relation("IndividualGoal", fields: [individualGoalId], references: [id], onDelete: Cascade)

  @@index([companyGoalId])
  @@index([individualGoalId])
}

// === TASKS & TRACKING ===

enum TaskType {
  IMPROVE    @map("GOAL_STACK")
  REACT
  MAINTENANCE
  REVIEW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  DROPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(cuid())
  ownerId        String
  goalId         String?
  processId      String?
  taskType       TaskType
  title          String
  description    String?      @db.Text
  deliverable    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  recurrenceRule String?
  calendarEventId String?
  timeBlockStart DateTime?
  timeBlockEnd   DateTime?
  estimatedMinutes    Int              @default(60)
  preferredTimeStart  String?
  preferredTimeEnd    String?
  isPinned            Boolean          @default(false)
  isAutoScheduled     Boolean          @default(false)
  isWinTheDay         Boolean          @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  rescheduledTo  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  aimInstanceId  String?
  assigneeId     String?
  parentId       String?

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  goal     Goal?         @relation(fields: [goalId], references: [id])
  process  Process?      @relation("TaskProcess", fields: [processId], references: [id])
  aimInstance AimInstance? @relation(fields: [aimInstanceId], references: [id])
  parent   Task?         @relation("TaskHierarchy", fields: [parentId], references: [id])
  children Task[]        @relation("TaskHierarchy")
  comments TaskComment[]
  publicWins PublicWin[]
  processExecution ProcessExecution?
  attachments TaskAttachment[]
  idea     Idea?
  trainingTask TrainingTask?
  clearGoals   ClearGoal[]

  @@index([ownerId])
  @@index([dueDate])
  @@index([status])
  @@index([goalId])
  @@index([ownerId, dueDate])
  @@index([ownerId, status])
  @@index([assigneeId])
  @@index([dueDate, status])
  @@index([goalId, status])
  @@index([parentId])
}

model Streak {
  id             String    @id @default(cuid())
  userId         String
  streakType     String
  currentCount   Int       @default(0)
  bestCount      Int       @default(0)
  lastActiveDate DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, streakType])
}

model PublicWin {
  id        String   @id @default(cuid())
  userId    String
  goalId    String?
  taskId    String?
  message   String
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id])
  task Task? @relation(fields: [taskId], references: [id])
}

// === RITUALS & REVIEWS ===

enum ReviewType {
  WEEKLY
  MONTHLY
  YEARLY
}

model Review {
  id                  String     @id @default(cuid())
  userId              String
  reviewType          ReviewType
  scheduledDate       DateTime
  completedAt         DateTime?
  notes               String?    @db.Text
  checklistState      Json?
  startDate           DateTime?
  recurrenceDayOfWeek Int?
  isTeamReview        Boolean    @default(false)
  timeBlockStart      DateTime?
  timeBlockEnd        DateTime?
  calendarEventId     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ReviewAnswer[]

  @@unique([userId, reviewType, scheduledDate])
  @@index([userId, reviewType])
  @@index([scheduledDate])
}

model ReviewTemplate {
  id             String     @id @default(cuid())
  reviewType     ReviewType
  checklistItems Json
  processSteps   Json
  isTeamTemplate Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([reviewType, isTeamTemplate])
}

model PowerdownSession {
  id             String    @id @default(cuid())
  userId         String
  sessionDate    DateTime
  currentStep    Int       @default(1)
  checklistState Json?
  tomorrowPlan   Json?
  distractions   Json?
  gratitudes     Json?
  ideas          Json?
  clearGoals     Json?
  completedAt    DateTime?
  timeBlockStart  DateTime?
  timeBlockEnd    DateTime?
  calendarEventId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionDate])
}

// === RECURRING TEAM REVIEWS ===

model RecurringTeamReview {
  id              String     @id @default(cuid())
  reviewType      ReviewType
  dayOfWeek       Int?       // 0=Sun, 1=Mon, ..., 6=Sat (required for WEEKLY)
  recurrenceRule  String?    // for monthly/yearly rules (e.g. "last-friday", "dec-30")
  time            String     // "HH:mm"
  duration        Int        @default(60)
  isActive        Boolean    @default(true)
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy User                      @relation("TeamReviewCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   RecurringTeamReviewMember[]
}

model RecurringTeamReviewMember {
  id                    String @id @default(cuid())
  recurringTeamReviewId String
  userId                String

  recurringTeamReview RecurringTeamReview @relation(fields: [recurringTeamReviewId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recurringTeamReviewId, userId])
  @@index([userId])
}

// === COLLABORATION ===

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions CommentMention[]

  @@index([taskId])
}

model CommentMention {
  id        String @id @default(cuid())
  commentId String
  userId    String

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([commentId])
}

// === NOTIFICATIONS ===

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  emailEnabled    Boolean @default(true)
  pushEnabled     Boolean @default(true)
  derailingAlerts Boolean @default(true)
  mentionAlerts   Boolean @default(true)
  reviewNags       Boolean @default(true)
  meetingReminders Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === INVITATIONS ===

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  role        String           @default("user")
  token       String?          @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
}

// === BUSINESS PROCESSES ===

enum ProcessCadence {
  ONE_TIME
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ProcessMode {
  BASIC
  ADVANCED
}

enum SubtaskMode {
  PAIRED
  UNPAIRED
}

model BusinessFunction {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  processes   Process[]
}

model Process {
  id            String          @id @default(cuid())
  functionId    String
  title         String
  description   String?         @db.Text
  assigneeId    String?
  delegateId    String?
  delegateUntil DateTime?
  cadence       ProcessCadence
  cadenceRule   String?
  mode          ProcessMode    @default(BASIC)
  subtaskMode   SubtaskMode    @default(PAIRED)
  defaultDurationMinutes Int    @default(60)
  scheduledTime       String?
  scheduledDayOfWeek  Int?
  scheduledDayOfMonth Int?
  scheduleStartDate   DateTime?
  sortOrder     Int             @default(0)
  lastRunAt     DateTime?
  nextDueAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  function     BusinessFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  assignee     User?            @relation("ProcessAssignee", fields: [assigneeId], references: [id])
  delegate     User?            @relation("ProcessDelegate", fields: [delegateId], references: [id])
  steps        ProcessStep[]
  executions   ProcessExecution[]
  ideas        Idea[]
  tasks        Task[]           @relation("TaskProcess")
  kpis         ProcessKpi[]

  @@index([functionId])
  @@index([assigneeId])
  @@index([nextDueAt])
}

model ProcessStep {
  id          String   @id @default(cuid())
  processId   String
  title       String
  description String?  @db.Text
  url         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model ProcessExecution {
  id            String    @id @default(cuid())
  processId     String
  executedById  String?
  scheduledDate DateTime
  completedAt   DateTime?
  taskId        String?   @unique
  timeBlockStart DateTime?
  timeBlockEnd   DateTime?
  createdAt     DateTime  @default(now())

  process       Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  executedBy    User?     @relation(fields: [executedById], references: [id])
  task          Task?     @relation(fields: [taskId], references: [id])

  @@index([processId, scheduledDate])
  @@index([scheduledDate])
}

// === MEETINGS ===

model Meeting {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  cadence     ProcessCadence
  dayOfWeek   Int?            // 0=Sun, 1=Mon, ... 6=Sat
  occurDate   DateTime?       // specific date for ONE_TIME meetings
  timeStart   String          // "09:00" format
  timeEnd     String          // "10:00" format
  attendeeIds     Json            // String[] of user IDs
  calendarEventId String?         // Google Calendar event ID for sync
  meetLink            String?         // Google Meet link (hangoutLink)
  lastReminderSentAt  DateTime?       // prevents duplicate reminder notifications
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

// === VERSIONING ===

model ConfigVersion {
  id            String   @id @default(cuid())
  stackId       String
  versionNum    Int
  yamlContent   String   @db.Text
  changeSummary String?
  createdById   String
  createdAt     DateTime @default(now())

  stack     GoalStack @relation(fields: [stackId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([stackId])
}

model Kpi {
  id          String    @id @default(cuid())
  goalId      String
  name        String
  type        KpiType
  unit        String?
  targetValue Float?
  actualValue Float?
  isComplete  Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  linkedKpiId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal       Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  linkedKpi  Kpi?  @relation("KpiLink", fields: [linkedKpiId], references: [id])
  linkedFrom Kpi[] @relation("KpiLink")

  @@unique([goalId, name])
  @@index([goalId])
  @@index([linkedKpiId])
}

// === IDEAS ===

enum IdeaStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  ARCHIVED
}

model Idea {
  id              String     @id @default(cuid())
  authorId        String
  title           String
  description     String     @db.Text
  processId       String?
  confidenceScore Int
  easeScore       Int
  impactScore     Int
  iceScore        Float?
  status          IdeaStatus @default(SUBMITTED)
  taskId          String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  process     Process?          @relation(fields: [processId], references: [id])
  task        Task?             @relation(fields: [taskId], references: [id])
  attachments IdeaAttachment[]

  @@index([authorId])
  @@index([status])
  @@index([iceScore])
}

model IdeaAttachment {
  id        String   @id @default(cuid())
  ideaId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  @@index([ideaId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
}

// === AIMS ===

model AimCategory {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  defaultFrequency  Int
  defaultDurationMin Int
  isGroupable       Boolean  @default(false)
  isDefault         Boolean  @default(true)
  isDaily           Boolean  @default(false)
  activities        Json?
  schedulePeriod    String   @default("both") // "working" | "casual" | "both"
  createdAt         DateTime @default(now())

  userAims     UserAim[]
  aimInstances AimInstance[]
}

model UserAim {
  id              String   @id @default(cuid())
  userId          String
  aimCategoryId   String
  isActive        Boolean  @default(true)
  customDuration  Int?
  customFrequency Int?
  customActivities     Json?
  customSchedulePeriod String?   // user override: "working" | "casual" | "both"
  currentPhase         String    @default("SEED")    // SEED | SPROUT | GROW | FLOW
  phaseStartedAt       DateTime  @default(now())
  completionCount      Int       @default(0)
  currentStreak        Int       @default(0)
  bestStreak           Int       @default(0)
  lastCompletedAt      DateTime?
  derailSensitivityDays Int      @default(1)   // missed days before "derailing"
  reminderTimeMinutes  Int?                     // minutes before end of day to remind
  createdAt            DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aimCategory AimCategory @relation(fields: [aimCategoryId], references: [id], onDelete: Cascade)

  @@unique([userId, aimCategoryId])
}

model AimInstance {
  id             String    @id @default(cuid())
  userId         String
  aimCategoryId  String
  scheduledDate  DateTime
  timeBlockStart DateTime?
  timeBlockEnd   DateTime?
  isGroupOpen    Boolean   @default(false)
  status         String    @default("SCHEDULED")
  completedAt      DateTime?
  activityNote     String?
  selectedActivity   String?   // e.g., "strength", "sauna", "painting"
  phaseAtCompletion  String?   // snapshot of phase when completed
  pointsEarned       Int       @default(0)
  calendarEventId    String?   // Google Calendar event ID for sync
  createdAt          DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aimCategory AimCategory @relation(fields: [aimCategoryId], references: [id], onDelete: Cascade)
  tasks       Task[]      // Deep Work container: nested tasks

  @@index([userId, scheduledDate])
}

// === TRAINING ===

enum TrainingType {
  BOOK
  COURSE
}

model TrainingItem {
  id                   String       @id @default(cuid())
  ownerId              String
  type                 TrainingType
  title                String
  description          String?      @db.Text
  sourceUrl            String?
  uploadedFileUrl      String?
  aiMetadata           Json?
  targetCompletionDate DateTime?
  goalId               String?
  status               String       @default("ACTIVE")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  goal          Goal?           @relation(fields: [goalId], references: [id])
  trainingTasks TrainingTask[]
  quizAttempts  QuizAttempt[]

  @@index([ownerId])
}

model TrainingTask {
  id             String  @id @default(cuid())
  trainingItemId String
  taskId         String  @unique
  chapterRange   String?
  moduleIndex    Int?
  isQuizDay      Boolean @default(false)
  sortOrder      Int     @default(0)

  trainingItem TrainingItem @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([trainingItemId])
}

model QuizAttempt {
  id             String    @id @default(cuid())
  trainingItemId String
  trainingTaskId String?
  questions      Json
  userAnswers    Json?
  score          Float?
  llmFeedback    Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  trainingItem TrainingItem @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)

  @@index([trainingItemId])
}

// === REVIEW ANSWERS ===

model ReviewAnswer {
  id         String   @id @default(cuid())
  reviewId   String
  stepKey    String   // identifies which step this answer belongs to
  answerType String   // "text" | "text_list" | "task_list" | "goal_list" | "priority_ranking" | "kpi_progress"
  answerData Json     // flexible storage for the answer content
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// === DISTRACTION LOG ===

model DistractionLog {
  id        String   @id @default(cuid())
  userId    String
  content   String
  notes     String?  @db.Text
  logDate   DateTime
  source    String   @default("powerdown") // "powerdown" | "manual"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, logDate])
}

// === CLEAR GOALS ===

model ClearGoal {
  id                  String    @id @default(cuid())
  taskId              String
  text                String
  isComplete          Boolean   @default(false)
  sortOrder           Int       @default(0)
  createdInPowerdownId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// === GOAL ASSIGNEES ===

model GoalAssignee {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([userId])
}

// === FEEDBACK ===

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// === COMPANY AUTH SETTINGS ===

model CompanyAuthSettings {
  id                String   @id @default(cuid())
  enforce2FA        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// === LOGIN ATTEMPT TRACKING ===

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// === PROCESS KPI SYSTEM ===

model ProcessKpi {
  id          String   @id @default(cuid())
  processId   String
  name        String
  unit        String?
  targetValue Float?
  goalId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  process    Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  goal       Goal?    @relation(fields: [goalId], references: [id])
  entries    ProcessKpiEntry[]
  goals      ProcessKpiGoal[]

  @@index([processId])
  @@index([goalId])
}

model ProcessKpiEntry {
  id        String   @id @default(cuid())
  kpiId     String
  userId    String
  value     Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  kpi  ProcessKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id])

  @@index([kpiId, date])
  @@index([userId])
}

enum KpiTimeLevel {
  WEEKLY
  MONTHLY
  YEARLY
  FIVE_YEAR
  HHG
}

model ProcessKpiGoal {
  id          String       @id @default(cuid())
  kpiId       String
  timeLevel   KpiTimeLevel
  targetValue Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  kpi ProcessKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, timeLevel])
  @@index([kpiId])
}
